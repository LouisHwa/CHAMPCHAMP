node_modules/
test-results/
playwright-report/
blob-report/
playwright/.cache/
playwright/.auth/*
!playwright/.auth/.gitkeep
allure-results/
allure-report/
.env
.DS_Store

# Raw cookie captures taken while transplanting a signed-in session.
# These hold live session values — convert them, then delete them.
cookie-header.txt
cookies-export.json
cookies.json

# Local reference material: the test basis documents (TCS/TPS/TDS) and any
# working notes. Kept out of the repo entirely so controlled documents are
# distributed through the team's own channel rather than through git. The
# .gitkeep is retained so the directory still exists on a fresh clone.
docs/*
!docs/.gitkeep
