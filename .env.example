# Copy this file to .env and fill in the values. .env is gitignored.
#
# SPR-24: credentials, reset links and confirmation emails are handled as
# test data and are NOT recorded in any shared or published artefact. Keep
# real values in .env only — never in .env.example, a spec, or a commit.
#
# In CI these are supplied as GitHub Actions Secrets instead, so .env is a
# local-only convenience. dotenv no-ops when the file is absent.

# The shopper account registered on the live store (ENV-02 / ENV-16).
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=

# IMAP access to that account's mailbox, for confirmation and password
# reset emails (ENV-15 / ENV-17). For Gmail this needs an App Password,
# not the account password, and IMAP enabled on the mailbox.
#   host imap.gmail.com   port 993
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_APP_PASSWORD=

# TD-05-E — the guest contact email bound in the refined TPS FN-05
# (competitiontdc2.0@gmail.com), used for TP-05-005's guest-order
# confirmation email check. A separate mailbox from TEST_ACCOUNT's
# above, so it needs its own IMAP credentials.
GUEST_EMAIL=
GUEST_IMAP_HOST=
GUEST_IMAP_PORT=993
GUEST_IMAP_USER=
GUEST_IMAP_APP_PASSWORD=
