{
  "name": "sdss-automated-tests",
  "version": "1.0.0",
  "description": "SDSS automated test suite — MSTB TDC 2.0, Young & Broke",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "ci:typecheck": "tsc --noEmit",
    "ci:discover": "playwright test --list",
    "ci:check-results": "node scripts/check-expected-results.mjs",
    "auth:setup": "playwright codegen --save-storage=playwright/.auth/user.json https://sauce-demo.myshopify.com/account/login",
    "auth:setup:chrome": "playwright codegen --channel=chrome --save-storage=playwright/.auth/user.json https://sauce-demo.myshopify.com/account/login",
    "auth:setup:edge": "playwright codegen --channel=msedge --save-storage=playwright/.auth/user.json https://sauce-demo.myshopify.com/account/login",
    "auth:cookie-to-state": "node scripts/cookies-to-storage-state.mjs",
    "auth:verify": "node scripts/verify-auth-session.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.0",
    "dotenv": "^17.4.2",
    "imapflow": "^1.6.5",
    "mailparser": "^3.9.14",
    "typescript": "^5.7.0"
  }
}
